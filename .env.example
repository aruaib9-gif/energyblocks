# Copy to .env.local and fill in. Never commit real keys.

# Paystack — https://dashboard.paystack.com/#/settings/developers
# Use sk_test_… while testing, sk_live_… in production. Without a key, development
# uses a built-in payment simulator; production refuses checkout.
PAYSTACK_SECRET_KEY=

# Public URL of the site, used for Paystack's return redirect.
SITE_URL=http://localhost:3000

# Database. Local dev uses a SQLite file; for production use Turso (libsql://…) + token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Signs admin session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# First admin: signing in with these creates the account (only while no admin exists).
# Remove ADMIN_PASSWORD from the environment afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
