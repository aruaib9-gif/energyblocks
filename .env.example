# Copy to .env.local for development, and add the same keys in Vercel →
# Project → Settings → Environment Variables for production. Never commit real values.

# ── Database: MongoDB Atlas ──────────────────────────────────────────────
# Atlas → your cluster → Connect → Drivers. In Network Access, allow 0.0.0.0/0
# (Vercel has no fixed IP addresses).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=energyblocks

# ── Payments: Paystack ───────────────────────────────────────────────────
# https://dashboard.paystack.com/#/settings/developers — sk_test_… first, sk_live_… later.
# Webhook URL to set there: https://YOUR-DOMAIN/api/webhooks/paystack
# Without a key, development uses a built-in simulator; production refuses checkout.
PAYSTACK_SECRET_KEY=

# ── Email: Resend ────────────────────────────────────────────────────────
# https://resend.com/api-keys. EMAIL_FROM must use a domain verified in Resend.
# Without a key, development prints emails to the server console.
RESEND_API_KEY=
EMAIL_FROM=Energy Blocks <orders@energyblocks.com>
# New paid-order alerts (comma-separate several addresses)
ADMIN_NOTIFY_EMAIL=info@energyblocks.com

# ── Product images: Cloudflare R2 ────────────────────────────────────────
# Cloudflare → R2 → create bucket. Account ID is on the R2 overview page.
# R2 → Manage API tokens → "Object Read & Write" for this bucket → Access Key ID + Secret.
# Public URL: bucket → Settings → Custom Domains (e.g. images.energyblocks.com), or enable
# the r2.dev URL for testing. Also add the CORS rule from the README.
# Without these, photos are stored in MongoDB instead (fine for testing, not for production).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=energyblocks-images
R2_PUBLIC_URL=https://images.energyblocks.com

# ── Site & admin ─────────────────────────────────────────────────────────
# Public URL, used in payment redirects and email links.
SITE_URL=http://localhost:3000
# Signs admin session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=
# First admin: signing in with these creates the account (only while no admin exists).
# Remove ADMIN_PASSWORD afterwards. Or run: npm run admin:create -- you@example.com "Name"
ADMIN_EMAIL=
ADMIN_PASSWORD=
